# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time (Expo's babel
# transform), not read at runtime — a build made without this file present at
# bundle time gets `undefined` here, and Cloud Receipt Scanning
# (src/lib/ocrProviders/gemini.ts) silently falls back to on-device OCR instead
# of failing loudly. See docs/V2_LAUNCH_CHECKLIST.md §1.
#
# Copy this to .env and fill in the deployed Worker URL
# (see server/receipt-ocr-proxy/README.md to deploy your own).
EXPO_PUBLIC_RECEIPT_OCR_PROXY_URL=

# Optional accounts + off-device encrypted backups (server/api/README.md).
# Leave this blank and the app has no account UI at all: no sign-in row in
# Settings, no server backup rows, nothing uploaded. Set it to the deployed
# Worker URL (e.g. https://budgetsplit-api.<subdomain>.workers.dev) to turn that
# on — and remember it is inlined at bundle time, so changing it needs a rebuild.
EXPO_PUBLIC_API_URL=
